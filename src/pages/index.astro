---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects } from '../data/projects';

export const prerender = true;

const stats = [
  { num: '6+',   en: 'years in B2B SaaS',                es: 'años en B2B SaaS' },
  { num: '4',    en: 'products built and led',           es: 'productos construidos y liderados' },
  { num: '80%',  en: 'less process time via automation', es: 'menos tiempo de procesos con automatización' },
  { num: '100%', en: 'milestones met on deadline',       es: 'hitos cumplidos en fecha' },
];

// What I do: three verticals, one profile (condensed from /what-i-do).
const verticals = [
  {
    color: 'var(--abm)', bg: 'rgba(235,104,52,.14)', icon: 'A',
    title: { en: 'ABM & Growth', es: 'ABM y Growth' },
    sub:   { en: 'Demand strategy for B2B SaaS', es: 'Estrategia de demanda para B2B SaaS' },
    body:  { en: 'Six years running account-based marketing for B2B SaaS: GTM strategy, CRM architecture, multichannel execution, and reporting to CMOs.', es: 'Seis años operando account-based marketing para B2B SaaS: estrategia GTM, arquitectura CRM, ejecución multicanal y reporting a CMOs.' },
  },
  {
    color: 'var(--dev)', bg: 'rgba(57,135,229,.14)', icon: '</>',
    title: { en: 'Software & Product', es: 'Software y Producto' },
    sub:   { en: 'From idea to working tool', es: 'De la idea a la herramienta que funciona' },
    body:  { en: 'I build the software behind the strategy: full web apps, LMS platforms, internal tools, and automation with Next.js, React, PHP, Python, and APIs.', es: 'Construyo el software detrás de la estrategia: apps web completas, plataformas LMS, herramientas internas y automatización con Next.js, React, PHP, Python y APIs.' },
  },
  {
    color: 'var(--pm)', bg: 'rgba(27,175,122,.14)', icon: 'PM',
    title: { en: 'Technical Project Management', es: 'Technical Project Management' },
    sub:   { en: 'The glue between both worlds', es: 'El pegamento entre los dos mundos' },
    body:  { en: 'I keep marketing, product, and engineering aligned: roadmaps, stakeholder management, delivery, and the processes that make a small team reliable.', es: 'Mantengo alineados marketing, producto e ingeniería: roadmaps, gestión de stakeholders, delivery y los procesos que hacen confiable a un equipo pequeño.' },
  },
];

// Condensed experience (full detail on /experience).
const jobs = [
  {
    role: { en: 'Technical Project Manager (ABM & Ops), Kalungi', es: 'Technical Project Manager (ABM y Ops), Kalungi' },
    meta: { en: 'Feb 2023 - Present · Seattle, USA (remote)', es: 'Feb 2023 - Presente · Seattle, USA (remoto)' },
    desc: {
      en: 'Primary technical liaison for CMOs and stakeholders. Led cross-functional teams, designed automated frameworks adopted company-wide, and built scripts that cut process time by 80%.',
      es: 'Enlace técnico principal para CMOs y stakeholders. Lideré equipos cross-funcionales, diseñé frameworks automatizados adoptados en toda la empresa y construí scripts que redujeron el tiempo de procesos en 80%.',
    },
  },
  {
    role: { en: 'Product Owner & Technical Lead, Meduco', es: 'Product Owner y Technical Lead, Meduco' },
    meta: { en: 'Dec 2025 - Present · Cuenca, Ecuador', es: 'Dic 2025 - Presente · Cuenca, Ecuador' },
    desc: {
      en: 'Architected and built a full EdTech ecosystem for medical professionals: public site, LMS, and admin dashboard, from market research to deployment.',
      es: 'Diseñé y construí un ecosistema EdTech completo para profesionales médicos: sitio público, LMS y panel administrativo, desde la investigación de mercado hasta el despliegue.',
    },
  },
  {
    role: { en: 'Marketing Operations Manager, Quash', es: 'Marketing Operations Manager, Quash' },
    meta: { en: 'Apr 2022 - Jan 2025 · Miami, USA', es: 'Abr 2022 - Ene 2025 · Miami, USA' },
    desc: {
      en: 'Designed B2B marketing automation, managed complex CRM environments, and built executive KPI dashboards to drive strategy.',
      es: 'Diseñé automatización de marketing B2B, gestioné entornos CRM complejos y construí dashboards de KPIs ejecutivos para guiar la estrategia.',
    },
  },
];

// Condensed stack (full detail on /stack).
const stackGroups = [
  { title: { en: 'Code & automation', es: 'Código y automatización' },
    items: ['Next.js', 'React', 'TypeScript', 'Python', 'PHP', 'REST APIs', 'PostgreSQL'] },
  { title: { en: 'Marketing & CRM', es: 'Marketing y CRM' },
    items: ['HubSpot', 'Salesforce', 'Apollo', 'ZoomInfo', 'Sales Navigator'] },
  { title: { en: 'Data & PM', es: 'Datos y PM' },
    items: ['Power BI', 'Zapier', 'Make', 'Asana', 'Slack'] },
];
---
<Base>
  <header class="hero hero-glow">
    <div class="wrap hero-grid">
      <div>
        <div class="eyebrow">RevOps · Automation · GTM Strategy</div>
        <h1>
          <span class="en">I run GTM strategy, and I <span class="grad">engineer the RevOps</span> that powers it.</span>
          <span class="es">Lidero la estrategia GTM, y <span class="grad">construyo el RevOps</span> que la impulsa.</span>
        </h1>
        <p class="lead en">Six-plus years in B2B SaaS where go-to-market meets systems. I design GTM and ABM strategy, integrate and architect CRMs like HubSpot and Salesforce, and build the automations and custom software that make revenue operations run end to end.</p>
        <p class="lead es">Más de seis años en B2B SaaS donde el go-to-market se cruza con los sistemas. Diseño estrategia de GTM y ABM, integro y arquitecto CRMs como HubSpot y Salesforce, y construyo las automatizaciones y el software a medida que hacen funcionar las revenue operations de punta a punta.</p>
        <div class="hero-cta">
          <a href="/projects" class="btn"><T en="See my work" es="Ver mi trabajo" /></a>
          <a href="#contact" class="btn ghost"><T en="Get in touch" es="Contacto" /></a>
        </div>
        <div class="socials">
          <a href="https://linkedin.com/in/juliomayaudon" target="_blank" rel="noopener">
            <svg class="sicon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
            LinkedIn
          </a>
          <a href="https://github.com/juliomayaudon" target="_blank" rel="noopener">
            <svg class="sicon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58l-.01-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.49 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.22.7.83.58C20.56 22.29 24 17.8 24 12.5 24 5.87 18.63.5 12 .5z"/></svg>
            GitHub
          </a>
          <a href="mailto:juliomayaudon3000@gmail.com">
            <svg class="sicon" viewBox="0 0 24 24" aria-hidden="true"><path d="M22 4H2a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h20a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1zm-1.6 2L12 11.6 3.6 6h16.8zM3 18V7.3l8.5 5.66a1 1 0 0 0 1.1 0L21 7.3V18H3z"/></svg>
            Email
          </a>
        </div>
      </div>
      <div class="photo"><img src="/julio.jpg" alt="Julio Mayaudon" width="720" height="964" /></div>
    </div>
  </header>

  <div class="wrap">
    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <div class="num">{s.num}</div>
          <div class="lbl"><T en={s.en} es={s.es} /></div>
        </div>
      ))}
    </div>
  </div>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker"><T en="What I do" es="Qué hago" /></div>
        <h2><T en="Three verticals, one profile" es="Tres verticales, un solo perfil" /></h2>
        <p><T en="Most people do one of these three. Doing all three in one person is what solves problems the others cannot touch." es="La mayoría hace una de estas tres. Hacer las tres en una sola persona resuelve problemas que otros no pueden tocar." /></p>
      </div>
      <div class="verticals">
        {verticals.map((v) => (
          <div class="vcard">
            <div class="bar" style={`background:${v.color}`}></div>
            <div class="vicon" style={`background:${v.bg}; color:${v.color}`}>{v.icon}</div>
            <h3><T en={v.title.en} es={v.title.es} /></h3>
            <div class="sub"><T en={v.sub.en} es={v.sub.es} /></div>
            <p class="desc" style="color:var(--text-2); font-size:14.5px"><T en={v.body.en} es={v.body.es} /></p>
          </div>
        ))}
      </div>
      <div style="margin-top:22px">
        <a href="/what-i-do" class="btn ghost"><T en="More on what I do →" es="Más sobre qué hago →" /></a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker"><T en="Selected work" es="Trabajo destacado" /></div>
        <h2><T en="Featured projects" es="Proyectos destacados" /></h2>
        <p><T en="Products and programs I have owned end to end." es="Productos y programas que he liderado de punta a punta." /></p>
      </div>
      <div class="projects">
        {featuredProjects.map((p) => <ProjectCard project={p} banner={false} />)}
      </div>
      <div style="margin-top:22px">
        <a href="/projects" class="btn ghost"><T en="All projects →" es="Todos los proyectos →" /></a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker"><T en="Career" es="Trayectoria" /></div>
        <h2><T en="Experience" es="Experiencia" /></h2>
        <p><T en="From marketing operations into technical leadership and product ownership." es="De operaciones de marketing hacia el liderazgo técnico y la propiedad de producto." /></p>
      </div>
      <div class="narrow">
        <div class="timeline">
          {jobs.map((j) => (
            <div class="tl-item">
              <div class="role"><T en={j.role.en} es={j.role.es} /></div>
              <div class="meta"><T en={j.meta.en} es={j.meta.es} /></div>
              <div class="desc"><T en={j.desc.en} es={j.desc.es} /></div>
            </div>
          ))}
        </div>
        <div style="margin-top:22px">
          <a href="/experience" class="btn ghost"><T en="Full career history →" es="Trayectoria completa →" /></a>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="sec-head">
        <div class="kicker"><T en="Tools" es="Herramientas" /></div>
        <h2><T en="Stack & technologies" es="Stack y tecnologías" /></h2>
        <p><T en="The tools I use across the three verticals." es="Las herramientas que uso en las tres verticales." /></p>
      </div>
      {stackGroups.map((g) => (
        <div class="stack-group">
          <h3><T en={g.title.en} es={g.title.es} /></h3>
          <div class="stack">
            {g.items.map((it) => <span class="chip">{it}</span>)}
          </div>
        </div>
      ))}
      <div style="margin-top:18px">
        <a href="/stack" class="btn ghost"><T en="Full stack & certifications →" es="Stack completo y certificaciones →" /></a>
      </div>
    </div>
  </section>

  <section id="contact">
    <div class="wrap">
      <div class="cta">
        <h2><T en="One person for the strategy and the software behind it." es="Una sola persona para la estrategia y el software que la sostiene." /></h2>
        <p><T en="Let's talk. I reply fast and I like a good growth problem, or a good code problem." es="Hablemos. Respondo rápido y me gusta un buen problema de growth, o de código." /></p>
        <div class="hero-cta" style="justify-content:center">
          <a href="mailto:juliomayaudon3000@gmail.com" class="btn"><T en="Email me" es="Escríbeme" /></a>
          <a href="https://linkedin.com/in/juliomayaudon" target="_blank" rel="noopener" class="btn ghost">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>
</Base>
