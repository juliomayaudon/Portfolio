---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Julio Mayaudon - RevOps, Automation & GTM',
  description = 'RevOps and automation for B2B SaaS. I design GTM and ABM strategy, integrate and architect CRMs, and build the automations and custom software behind revenue operations.',
} = Astro.props;
---
<!doctype html>
<html lang="en" data-lang="en" data-style="minimal">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <!-- Apply saved language before paint to avoid a flash. Style is fixed to minimal. -->
    <script is:inline>
      (function () {
        try {
          var l = localStorage.getItem('pf-lang') || 'en';
          var r = document.documentElement;
          r.setAttribute('data-lang', l);
          r.setAttribute('lang', l);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      function toggleLang() {
        var r = document.documentElement;
        var next = r.getAttribute('data-lang') === 'en' ? 'es' : 'en';
        r.setAttribute('data-lang', next);
        r.setAttribute('lang', next);
        try { localStorage.setItem('pf-lang', next); } catch (e) {}
        syncToggles();
      }
      function toggleMenu() {
        var nav = document.querySelector('nav');
        if (!nav) return;
        var open = nav.getAttribute('data-open') === 'true';
        nav.setAttribute('data-open', open ? 'false' : 'true');
        var btn = nav.querySelector('.navtoggle');
        if (btn) btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      }
      window.toggleMenu = toggleMenu;
      document.addEventListener('click', function (e) {
        var nav = document.querySelector('nav');
        if (!nav || nav.getAttribute('data-open') !== 'true') return;
        var t = e.target;
        if (t.closest('.navlinks a') || t.closest('.nav-right a')) {
          nav.setAttribute('data-open', 'false');
          var btn = nav.querySelector('.navtoggle');
          if (btn) btn.setAttribute('aria-expanded', 'false');
        }
      });
      function syncToggles() {
        var r = document.documentElement;
        var lang = r.getAttribute('data-lang');
        var le = document.getElementById('t-en'), ls = document.getElementById('t-es');
        if (le) le.classList.toggle('on', lang === 'en');
        if (ls) ls.classList.toggle('on', lang === 'es');
      }
      window.toggleLang = toggleLang;
      document.addEventListener('DOMContentLoaded', syncToggles);
      syncToggles();
    </script>
  </body>
</html>
